# Auto-detect text vs binary
* text=auto

# Unity YAML text assets - force LF to prevent corruption
*.asset text eol=lf
*.unity text eol=lf
*.prefab text eol=lf
*.mat text eol=lf
*.anim text eol=lf
*.controller text eol=lf
*.overrideController text eol=lf
*.physicsMaterial2D text eol=lf
*.physicsMaterial text eol=lf
*.guiskin text eol=lf
*.fontsettings text eol=lf
*.meta text eol=lf
*.shadergraph text eol=lf

# Unity binary assets - never touch line endings
*.fbx binary
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.tga binary
*.tiff binary
*.psd binary
*.wav binary
*.mp3 binary
*.ogg binary
*.dll binary
*.pdb binary

# C# / Python source - LF
*.cs text eol=lf
*.py text eol=lf
*.json text eol=lf
*.md text eol=lf
